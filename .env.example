# Copy to .env for local development. Never commit real credentials.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
NODE_ENV=development

# Optional but strongly recommended for calls across restrictive NATs.
# Use a TURN server configured with the TURN REST API shared secret.
TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349?transport=tcp
TURN_SHARED_SECRET=


# Managed TURN relay (recommended for reliable calls across restrictive NATs/firewalls).
# Create a TURN key in Cloudflare Realtime and keep its key ID + API token on the server only.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_KEY_API_TOKEN=
